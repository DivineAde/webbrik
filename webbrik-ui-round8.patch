+/* ── Motion: reveal on scroll, no JavaScript ──────────
+   Transform and opacity only, tied to scroll position. Browsers without scroll timelines just show the content. */
+@media (prefers-reduced-motion: no-preference) {
+  html { scroll-behavior: smooth; }
+  @supports (animation-timeline: view()) {
+    .lp-copy, .lx-gal-head, .lx-devices, .lx-export > *, .lx-cell, .lp-plan, .lx-faq > *, .lp-split > *, .lp-close-in, .lx-marquee {
+      animation: lx-rise linear backwards; animation-timeline: view(); animation-range: entry 0% entry 32%;
+    }
+    .lx-code, .lx-devices .snap { animation: none; }
+  }
+  @keyframes lx-rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
+  /* FAQ answers open smoothly where the browser supports it. */
+  @supports (interpolate-size: allow-keywords) {
+    :root { interpolate-size: allow-keywords; }
+    .lx-faq details::details-content { block-size: 0; overflow: hidden; transition: block-size .3s ease, content-visibility .3s allow-discrete; }
+    .lx-faq details[open]::details-content { block-size: auto; }
+  }
+}
+.lp [id] { scroll-margin-top: 72px; }
