# Durable storage (pick one). Production refuses to start without it unless ALLOW_EPHEMERAL=1.
# SQLITE_PATH=./data/webbrik.db
DATABASE_URL=postgresql://webbrik:webbrik@localhost:5432/webbrik
REDIS_URL=redis://localhost:6379
# Object storage for uploaded files (Backblaze B2, S3 compatible). Leave blank to keep files in memory (lost on restart).
# In Backblaze: create a bucket (Private is fine), then App Keys > Add a New Application Key limited to that bucket.
#   S3_ENDPOINT   the bucket's S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com
#   S3_BUCKET     the bucket name
#   S3_ACCESS_KEY the application key's keyID
#   S3_SECRET_KEY the application key itself (shown once)
#   S3_REGION     optional; taken from the endpoint (us-west-004)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
WEB_ORIGIN=http://localhost:3000
SECRET_KEY=change-me

# Public address of the web app (used in email links and the Paystack return URL). Required in production.
APP_URL=http://localhost:3000
# Email over SMTP: either one URL (smtp:// or smtps://user:pass@host:port) or the separate settings. Required in production (or ALLOW_OUTBOX=1).
SMTP_URL=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM="Webbrik <no-reply@example.com>"
# Payments with Paystack. Webhook URL to set in the Paystack dashboard: <API origin>/v1/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_AMOUNT=1500000   # price in minor units (kobo): 1500000 = NGN 15,000.00
PAYSTACK_CURRENCY=NGN
PAYSTACK_PLAN_PRO=            # optional Paystack plan code (PLN_...) for automatic monthly renewal

# Run several API instances against one database: writes wait for the database and every request first pulls other instances' changes.
# MULTI_INSTANCE=1
PAYSTACK_PLAN_TEAM=           # optional Paystack plan code for Team (amount must include tax)
PAYSTACK_TEAM_AMOUNT=         # minor units; default 3x Pro
BILLING_TAX_PERCENT=0         # e.g. 7.5, added last on every charge
BILLING_TAX_LABEL=VAT
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
ADMIN_EMAILS=                 # comma-separated; may manage coupons
WORKER_TOKEN=                 # shared secret: worker -> API /v1/internal
API_URL=http://localhost:4000 # used by the worker
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GITHUB_CLIENT_ID= # OAuth login button shows only when set
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REALTIME_URL=     # optional; default same-origin /api/realtime

# Logging: error | warn | log (default) | debug. LOG_REQUESTS=0 hides the one-line-per-request output.
LOG_LEVEL=log
LOG_REQUESTS=1
