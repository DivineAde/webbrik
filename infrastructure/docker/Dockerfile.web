FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY . .
# Next bakes the /api rewrite target at build time
ARG API_URL=http://api:4000
ENV API_URL=$API_URL
RUN pnpm install --frozen-lockfile=false && pnpm --filter @webbrik/web build
EXPOSE 3000
CMD ["pnpm", "--filter", "@webbrik/web", "exec", "next", "start", "-p", "3000"]
